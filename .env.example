# Server
PORT=3000
NODE_ENV=development

# Security - CHANGE THESE IN PRODUCTION
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=7d
ADMIN_NAME=Demeke Biyazen
ADMIN_PASSWORD=demeke0929@

# Public base URL used for payment return/callback URLs (must be reachable by the gateway)
APP_BASE_URL=http://localhost:3000

# Telebirr receiving account (used for manual transfer mode)
TELEBIRR_ACCOUNT=0929853878

# Payment mode: manual | chapa
#   manual -> students transfer to the Telebirr account and an admin approves each payment
#   chapa  -> automatic verification through Chapa (accepts Telebirr, cards and wallets)
PAYMENT_MODE=manual

# Chapa credentials (https://dashboard.chapa.co) - required when PAYMENT_MODE=chapa
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
CHAPA_BASE_URL=https://api.chapa.co/v1

# Direct Telebirr Merchant API credentials (reserved for future use)
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
TELEBIRR_PUBLIC_KEY=
TELEBIRR_MERCHANT_CODE=
TELEBIRR_BASE_URL=https://app.ethiotelecom.et:9002

# Admin notifications via Telegram (optional).
# Create a bot with @BotFather for the token, then get your chat id from
# https://api.telegram.org/bot<token>/getUpdates . Leave empty to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Database file location
DB_PATH=./data/app.db
